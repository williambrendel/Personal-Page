{
  "name": "personal-page-server",
  "version": "1.0.0",
  "description": "RAG backend for william-brendel.com — ask-nereus retrieval engine, personal corpus",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "main": "./app.js",
  "scripts": {
    "app": "node app.js",
    "ingest": "node scripts/ingest.js",
    "ask": "node scripts/ask.js",
    "prewarm": "node scripts/prewarm.js",
    "retrieve": "node scripts/retrieve.js",
    "tune-floor": "node scripts/tune-floor.js",
    "manifest": "node scripts/manifest.js",
    "verify": "node scripts/manifest.js --verify",
    "site": "python3 scripts/serve-site.py",
    "coverage": "node scripts/coverage.js",
    "calibrate-gate": "node scripts/calibrate-gate.js",
    "push-models": "bash scripts/push-models.sh",
    "ship": "bash scripts/ship.sh",
    "measure-actions": "node scripts/measure-actions.js",
    "stamp": "node scripts/stamp-site.js",
    "check-starters": "node scripts/check-starters.js",
    "follow-ups": "node scripts/follow-ups.js",
    "query-baseline": "node scripts/query-baseline.js",
    "check-imports": "node scripts/check-library-imports.js",
    "golden": "node scripts/golden-retrieval.js",
    "test": "node scripts/check-library-imports.js && node scripts/manifest.js --verify && node scripts/golden-retrieval.js && node scripts/check-starters.js"
  },
  "author": "William Brendel",
  "license": "MIT",
  "dependencies": {
    "@williambrendel/llms": "~2.4.2",
    "@williambrendel/markdown": "^0.1.2",
    "@williambrendel/pwa": "^0.4.0",
    "@williambrendel/utils": "^1.13.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  }
}
