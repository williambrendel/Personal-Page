# The @williambrendel packages are private, on GitHub Packages.
#
# The token is read from the environment and never written here: this file is
# committed, and a token in a committed file is a token to rotate. Locally,
# `gh auth token` already carries read:packages; in CI the deploy workflow
# exports the same secret ship.sh uses.
#
#   export NODE_AUTH_TOKEN="$(gh auth token)"   # then npm install
#
@williambrendel:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
